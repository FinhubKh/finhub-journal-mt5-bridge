BRIDGE_SERVICE_TOKEN=replace-with-openssl-rand-hex-32
JOURNAL_BRIDGE_SYNC_URL=https://your-journal-host/v1/bridge/sync

# Host worker uses localhost. docker-compose overrides this to redis://redis:6379/0 for the API container.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_KEY=finhubkh:mt5:sync_jobs

MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# 2 workers: overlap journal HTTP with the next MT5 login (single terminal lock)
WORKER_POOL_SIZE=2
HISTORY_LOOKBACK_DAYS=90
BRIDGE_API_HOST=0.0.0.0
BRIDGE_API_PORT=8788

MT5_LOCK_KEY=finhubkh:mt5:terminal_lock
MT5_LOCK_TTL_SECONDS=300
MT5_LOCK_WAIT_SECONDS=120
