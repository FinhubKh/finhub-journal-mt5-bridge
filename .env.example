BRIDGE_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# Bridge upserts trades into Supabase (same project as the journal web app)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Same AES key as the journal — workers decrypt investor passwords from Supabase
# instead of keeping them in the Redis job queue.
INVESTOR_CRED_ENCRYPTION_KEY=replace-with-same-64-hex-as-journal

# Host worker uses localhost. docker-compose overrides this to redis://redis:6379/0 for the API container.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_KEY=finhubkh:mt5:sync_jobs

MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# Portable MetaTrader 4 terminal used for investor-password sync (MT4 accounts).
# Keep FinhubJournal_BridgeExport.mq4 attached to a chart on this terminal.
MT4_TERMINAL_PATH=C:\\MT4_Portable\\terminal.exe
# Optional JSON map (server prefix → terminal.exe). See config/mt4_terminal_map.json
MT4_TERMINAL_MAP_PATH=
# Cap a single login attempt so one bad/unreachable broker can't hold the MT5
# lock for MT5's own 60s default and starve every other queued job.
MT5_INIT_TIMEOUT_MS=15000
MT4_INIT_TIMEOUT_MS=150000
# Match installed portable slots (see config/*_terminal_map.json "slots" +
# scripts/clone-terminal-slots.ps1). Per-path locks allow true parallelism.
WORKER_POOL_SIZE=4
# Floor for incremental sync windows when last_synced_at is very old.
HISTORY_LOOKBACK_DAYS=90
# One-shot first sync pulls this many days of history (~20y ≈ full retail history).
# Later Sync Now is incremental only. Raise further only if you need older deals.
HISTORY_BACKFILL_DAYS=7300
BRIDGE_API_HOST=0.0.0.0
BRIDGE_API_PORT=8788

MT5_LOCK_KEY=finhubkh:mt5:terminal_lock
MT5_LOCK_TTL_SECONDS=600
MT5_LOCK_WAIT_SECONDS=120
MT4_LOCK_KEY=finhubkh:mt4:terminal_lock
MT4_LOCK_TTL_SECONDS=900
MT4_LOCK_WAIT_SECONDS=180
# Don't requeue an in-progress sync while a 10-year cashflow backfill is still running.
PROCESSING_STALE_SECONDS=600
